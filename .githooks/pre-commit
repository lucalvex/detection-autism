#!/usr/bin/env bash
# ============================================================
# Hook de pre-commit: bloqueia vídeos, CSVs, arrays de dados
# (.npy/.npz), arquivos *_pontos.json (keypoints em pixels brutos da
# demo -- dado de sessão, não código nem resultado agregado), imagens
# (.png/.jpg/.jpeg) fora de figuras/ e qualquer arquivo acima de 5MB.
#
# Motivo: esses arquivos são grandes e derivados (regeneráveis a
# partir do pipeline), e já entraram no histórico do repositório por
# engano antes -- este hook existe para não deixar isso acontecer de
# novo. Não impede o TRABALHO local (os arquivos continuam no disco,
# usados normalmente pelo treino/avaliação); só impede que entrem no
# commit.
#
# Ativação (não roda sozinho -- precisa disso 1x por clone):
#   git config core.hooksPath .githooks
#
# Para pular em um commit específico (uso consciente, ex. o próprio
# .gitignore/README): git commit --no-verify
# ============================================================

set -euo pipefail

MAX_BYTES=$((5 * 1024 * 1024))
BLOCKED_EXT_REGEX='\.(mp4|avi|mov|mkv|npy|npz|csv)$'
BLOCKED_SUFFIX_REGEX='_pontos\.json$'
# imagens só em figuras/ (figuras do texto; nunca quadros de vídeo)
BLOCKED_IMAGE_REGEX='\.(png|jpe?g)$'
ALLOWED_IMAGE_PREFIX='figuras/'

violations=()

# --diff-filter=ACMR: checa arquivos Adicionados/Copiados/Modificados/
# Renomeados. Exclui D (Deleted) de propósito -- um commit que só
# remove um arquivo do rastreamento (ex. `git rm --cached`) deve
# passar sempre, mesmo que o arquivo removido fosse um vídeo/CSV/etc.
# Inclui R para pegar o caso de alguém renomear um vídeo/arquivo
# grande para escapar da checagem por extensão.
while IFS= read -r -d '' file; do

  size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)

  if echo "$file" | grep -Eiq "$BLOCKED_EXT_REGEX"; then
    violations+=("$file -- extensão bloqueada (vídeo/CSV/array de dados)")
  elif echo "$file" | grep -Eiq "$BLOCKED_SUFFIX_REGEX"; then
    violations+=("$file -- dado de sessão da demo (*_pontos.json), não deve ser versionado")
  elif echo "$file" | grep -Eiq "$BLOCKED_IMAGE_REGEX" && [[ "$file" != "$ALLOWED_IMAGE_PREFIX"* ]]; then
    violations+=("$file -- imagem fora de figuras/ (pode ser quadro de vídeo)")
  elif [ "$size" -gt "$MAX_BYTES" ]; then
    violations+=("$file -- $((size / 1024 / 1024))MB (limite: 5MB)")
  fi

done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#violations[@]}" -gt 0 ]; then
  echo "COMMIT BLOQUEADO pelo hook .githooks/pre-commit:" >&2
  echo "" >&2
  printf '  - %s\n' "${violations[@]}" >&2
  echo "" >&2
  echo "Vídeos, CSVs, arrays de dados (.npy/.npz), *_pontos.json e imagens fora" >&2
  echo "de figuras/ não devem ser versionados, e nenhum arquivo deve passar de 5MB. Se isso for" >&2
  echo "realmente intencional, use 'git commit --no-verify' para pular esta checagem." >&2
  exit 1
fi

exit 0
