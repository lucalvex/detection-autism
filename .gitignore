# Permissão do Claude
.claude/

# Ambiente virtual Python
.venv/

# Arquivos compilados Python
__pycache__/
*.pyc

# Modelos treinados
models/*.pt
models/*.pth
models/oof*/*.pt

# Vídeos, em qualquer pasta (inclui data/results/annotated_video.mp4,
# data/videos/*.mp4, videos/*.mp4)
*.mp4
*.avi
*.mov
*.mkv
# pasta local dos vídeos e dos XMLs de anotação do SSBD (data/videos/xmls/)
data/videos/

# Resultados
results/

# Saída do exportador da demo (sessao.json/pontos.json por vídeo --
# dados de sessão, nunca vão para o git)
saidas/
*_pontos.json

# Dataset gerado
datasets/
datasets_annotated/
keyframes/

# Arrays de dataset (X.npy/y.npy/groups.npy/*.npz), qualquer pasta futura
*.npy
*.npz

# CSVs gerados (inclui data/poses/*.csv), qualquer pasta
*.csv

# Imagens: bloqueadas em qualquer pasta, exceto demo/assets/ (só elementos
# da interface, como a logo); nunca quadros de vídeo nem imagens de crianças
*.png
*.jpg
*.jpeg
!/demo/assets/**/*.png
!/demo/assets/**/*.jpg
!/demo/assets/**/*.jpeg

# Configurações do VS Code
.vscode/
# YOLO11m-Pose (experimentos/, etapa 2) -- pesos não vão para o git
models/yolo11m-pose.pt

# Experimentos: poses (dados de pose), modelos, pontuações e arquivos de andamento
experimentos/poses/
experimentos/**/modelos/
experimentos/**/*.pkl
experimentos/**/particao_*.json
experimentos/**/andamento_*.txt
experimentos/progresso.log
experimentos/rodando.pid
experimentos/*.log
experimentos/*.pid

# Imagens de esqueleto gravadas pelo pipeline antigo
data/results/keyframes/
