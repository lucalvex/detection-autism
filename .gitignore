# Permissão do Claude
.claude/

# Ambiente virtual Python
.venv/

# Arquivos compilados Python
__pycache__/
*.pyc

# Modelos treinados
models/*.pt
models/*.pth
models/oof*/*.pt

# Vídeos, em qualquer pasta (inclui data/results/annotated_video.mp4,
# data/videos/*.mp4, videos/*.mp4)
*.mp4
*.avi
*.mov
*.mkv

# Resultados
results/

# Saída do exportador da demo (sessao.json/pontos.json por vídeo --
# dados de sessão, nunca vão para o git; ver tcc-demo-handoff/HANDOFF.md)
saidas/
*_pontos.json

# Dataset gerado
datasets/
datasets_annotated/
keyframes/

# Arrays de dataset (X.npy/y.npy/groups.npy/*.npz), qualquer pasta futura
*.npy
*.npz

# CSVs gerados (inclui data/poses/*.csv), qualquer pasta
*.csv

# Imagens: bloqueadas em qualquer pasta, exceto figuras/ (só figuras do
# texto) e demo/assets/ (só elementos da interface, como a logo); nenhuma
# das duas pode ter quadros de vídeo nem imagens de crianças
*.png
*.jpg
*.jpeg
!/figuras/**/*.png
!/figuras/**/*.jpg
!/figuras/**/*.jpeg
!/demo/assets/**/*.png
!/demo/assets/**/*.jpg
!/demo/assets/**/*.jpeg

# Configurações do VS Code
.vscode/